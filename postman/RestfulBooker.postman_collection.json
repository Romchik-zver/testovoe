      "name": "02. Booking - Create (POST /booking)",
      "item": [
        {
          "name": "TC-BOOK-P-01 | Valid full booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-BOOK-P-01: create valid booking, verify structure, save bookingId.",
                  "pm.test('TC-BOOK-P-01a | Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('TC-BOOK-P-01b | Has bookingid', () => pm.expect(j).to.have.property('bookingid'));",
                  "pm.test('TC-BOOK-P-01c | bookingid is integer > 0', () => { pm.expect(j.bookingid).to.be.a('number'); pm.expect(j.bookingid).to.be.above(0); });",
                  "pm.test('TC-BOOK-P-01d | booking object present', () => pm.expect(j).to.have.property('booking'));",
                  "pm.test('TC-BOOK-P-01e | firstname echoed', () => pm.expect(j.booking.firstname).to.eql('Jim'));",
                  "pm.test('TC-BOOK-P-01f | lastname echoed', () => pm.expect(j.booking.lastname).to.eql('Brown'));",
                  "pm.test('TC-BOOK-P-01g | totalprice echoed', () => pm.expect(j.booking.totalprice).to.eql(111));",
                  "pm.test('TC-BOOK-P-01h | depositpaid echoed', () => pm.expect(j.booking.depositpaid).to.eql(true));",
                  "pm.test('TC-BOOK-P-01i | bookingdates present', () => pm.expect(j.booking.bookingdates).to.have.property('checkin'));",
                  "pm.test('TC-BOOK-P-01j | checkout present', () => pm.expect(j.booking.bookingdates).to.have.property('checkout'));",
                  "if (j.bookingid) { pm.environment.set('bookingId', j.bookingid); pm.collectionVariables.set('bookingId', j.bookingid); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}" },
