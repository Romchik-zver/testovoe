                  "// TC-AUTH-P-01: positive. admin/password123 -> 200 + token.",
                  "pm.test('TC-AUTH-P-01a | Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('TC-AUTH-P-01b | Has token property', () => pm.expect(j).to.have.property('token'));",
                  "pm.test('TC-AUTH-P-01c | Token is non-empty string', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.token.length).to.be.above(0); });",
                  "pm.test('TC-AUTH-P-01d | Token has reasonable length (>=5)', () => pm.expect(j.token.length).to.be.at.least(5));",
                  "if (j.token) { pm.environment.set('token', j.token); pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth", "host": ["{{baseUrl}}"], "path": ["auth"] }
