    {
      "name": "00. Health / Ping",
      "item": [
        {
          "name": "TC-PING-P-01 | GET /ping returns OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-PING-P-01: health-check endpoint.",
                  "// Expected: HTTP 200 OK, body 'Created'.",
                  "// KNOWN BUG (BUG-01): API returns 201 Created instead of 200 OK.",
                  "pm.test('TC-PING-P-01a | Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test('TC-PING-P-01b | Body contains \"Created\"', () => pm.expect(pm.response.text()).to.include('Created'));",
                  "pm.test('TC-PING-P-01c | Status is 200 OK  [known bug BUG-01 will fail this]', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ping", "host": ["{{baseUrl}}"], "path": ["ping"] }
          }
        }
      ]
    },
